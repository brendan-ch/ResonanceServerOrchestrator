{
  "Urls": "http://0.0.0.0:9000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Orchestrator": {
    "UnityServerPath": "/opt/resonance/server/ResonanceServer.x86_64",
    "UnityServerBaseArgs": "-batchmode -nographics",
    "OrchestratorUrl": "http://localhost:9000",
    "LauncherType": "LocalProcess",
    "MaxMatches": 1,
    "MatchTimeoutMinutes": 30,
    "GameServerHost": "localhost",
    "GameServerPort": 7777,
    "RosterAssemblyTimeoutSeconds": 45,
    "ServerReadyTimeoutSeconds": 30,
    "TombstoneRetentionMinutes": 10,
    "CleanupIntervalSeconds": 60
  }
}
