{
  "Urls": "http://0.0.0.0:9000",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Orchestrator": {
    "UnityServerPath": "./Server/ResonanceServer.x86_64",
    "UnityServerBaseArgs": "-batchmode -nographics",
    "OrchestratorUrl": "http://localhost:9000",
    "LauncherType": "None",
    "SteamCredentialCheckDisabled": true,
    "MaxMatches": 1,
    "MatchTimeoutMinutes": 30,
    "LocalGameServerHost": "localhost",
    "LocalGameServerInternalAndExternalPort": 7777,
    "RosterAssemblyTimeoutSeconds": 45,
    "ServerReadyTimeoutSeconds": 30,
    "TombstoneRetentionMinutes": 10,
    "CleanupIntervalSeconds": 60
  }
}
